---
const year = new Date().getFullYear();
---

<footer class="border-t border-border/40">
  <div class="mx-auto flex max-w-3xl flex-col items-start justify-between gap-4 px-6 py-8 sm:flex-row sm:items-center">
    <p class="text-sm text-text-muted">
      &copy; {year} Pixel Arc Labs. All rights reserved.
    </p>

    <ul class="flex items-center gap-6">
      <li>
        <a
          href="/privacy"
          class="text-sm text-text-muted transition-colors hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg rounded-sm"
        >
          Privacy Policy
        </a>
      </li>
      <li>
        <a
          href="/contact"
          class="text-sm text-text-muted transition-colors hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg rounded-sm"
        >
          Contact
        </a>
      </li>
    </ul>
  </div>
</footer>
