---
import { supportEmail } from '../config/site';
---

<section id="support" class="scroll-mt-28 border-t border-border">
  <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <h2 class="rule-label" data-reveal>
      <span class="text-accent">03</span>
      Support
    </h2>

    <div class="mt-14" data-reveal>
      <p class="text-4xl font-semibold tracking-tight text-text sm:text-6xl">
        Need a hand?
        <span class="font-display font-normal italic text-text-muted">I'm here.</span>
      </p>

      <p class="mt-8 max-w-lg text-base leading-relaxed text-text-muted">
        Official support for every Pixel Arc Labs app. Write me directly —
        I typically reply within a day.
      </p>

      <div class="mt-12">
        <a
          href={`mailto:${supportEmail}`}
          class="font-display text-[clamp(1.5rem,4.5vw,3rem)] italic text-text underline decoration-border decoration-1 underline-offset-8 transition-colors hover:text-accent hover:decoration-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
        >
          {supportEmail}
        </a>
      </div>

      <div class="mt-14">
        <a href="/contact" class="link-arrow">
          Or use the contact form
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
