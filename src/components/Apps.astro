---
import { apps } from '../config/site';
---

<section id="apps" class="scroll-mt-28">
  <div class="mx-auto max-w-5xl px-6 pt-24 sm:pt-32">
    <h2 class="rule-label" data-reveal>
      <span class="text-accent">01</span>
      Apps
    </h2>
  </div>

  <div class="mx-auto mt-14 max-w-5xl px-6">
    {
      apps.map((app, index) => (
        <article
          id={app.id}
          class="app-row scroll-mt-28 border-t border-border last:border-b"
          data-reveal
        >
          <div class="grid gap-8 py-12 sm:grid-cols-[auto_1fr] sm:gap-12 sm:py-16">
            <div class="flex flex-row items-start gap-6 sm:flex-col sm:gap-8">
              <span class="font-mono text-[0.6875rem] tracking-[0.2em] text-text-muted">
                {String(index + 1).padStart(2, '0')} / {app.platform.toUpperCase()}
              </span>
              <img
                src={app.iconSrc}
                alt=""
                width="96"
                height="96"
                class="h-20 w-20 rounded-[1.25rem] object-cover ring-1 ring-white/10 sm:h-24 sm:w-24 sm:rounded-[1.5rem]"
              />
            </div>

            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
                <h3 class="app-row-name text-4xl font-semibold tracking-tight text-text sm:text-5xl">
                  {app.name}
                </h3>
                <p class="font-display text-xl italic text-text-muted sm:text-2xl">
                  {app.tagline}
                </p>
              </div>

              <p class="mt-6 max-w-xl text-base leading-relaxed text-text-muted sm:text-lg">
                {app.description}
              </p>

              <p class="mt-8 max-w-xl font-mono text-[0.625rem] uppercase leading-loose tracking-[0.16em] text-text-muted/80">
                {app.features.map((feature, i) => (
                  <span>
                    {feature}
                    {i < app.features.length - 1 && <span class="mx-2.5 text-accent">/</span>}
                  </span>
                ))}
              </p>

              <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-5">
                {app.buyPath && app.price ? (
                  <a href={app.buyPath} class="link-arrow">
                    Buy — {app.price}
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                ) : app.appStoreUrl ? (
                  <a href={app.appStoreUrl} class="link-arrow" rel="noopener noreferrer" target="_blank">
                    App Store
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span class="border border-border px-4 py-2 font-mono text-[0.625rem] uppercase tracking-[0.2em] text-text-muted">
                    Coming soon
                  </span>
                )}

                <span class="flex gap-6 font-mono text-[0.625rem] uppercase tracking-[0.18em]">
                  <a
                    href={app.privacyPath}
                    class="text-text-muted transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
                  >
                    Privacy
                  </a>
                  <a
                    href={app.termsPath}
                    class="text-text-muted transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
                  >
                    Terms
                  </a>
                </span>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
