---
import { apps } from '../config/site';
---

<section id="apps" class="border-t border-border/40 scroll-mt-28">
  <div class="mx-auto max-w-3xl px-6 py-24 sm:py-28">
    <h2 class="text-sm font-medium tracking-wide text-accent uppercase">Apps</h2>

    <div class="mt-8 space-y-8">
      {
        apps.map((app) => (
          <article
            id={app.id}
            class="onyx-card scroll-mt-28 overflow-hidden rounded-2xl border border-border bg-bg-muted"
          >
            <div class="flex flex-col gap-8 p-8 sm:flex-row sm:items-center">
              <div class="flex shrink-0 justify-center sm:justify-start">
                <img
                  src={app.iconSrc}
                  alt=""
                  width="120"
                  height="120"
                  class="h-28 w-28 rounded-[1.75rem] object-cover shadow-lg ring-1 ring-white/10"
                />
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="text-2xl font-bold tracking-tight text-text">{app.name}</h3>
                  <span class="rounded-full border border-border bg-bg-elevated px-2.5 py-0.5 text-xs font-medium text-text-muted">
                    iOS
                  </span>
                </div>

                <p class="mt-1 text-sm font-medium text-text-muted">{app.fullName}</p>

                <p class="mt-4 text-lg leading-relaxed text-text-muted">{app.description}</p>

                <ul class="mt-6 space-y-2">
                  {app.features.map((feature) => (
                    <li class="flex items-start gap-2 text-sm text-text-muted">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="mt-0.5 shrink-0 text-accent"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>

                <div class="mt-8 flex flex-wrap items-center gap-3">
                  {app.appStoreUrl ? (
                    <a
                      href={app.appStoreUrl}
                      class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-muted"
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      Download on the App Store
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                      </svg>
                    </a>
                  ) : (
                    <span class="inline-flex items-center rounded-full border border-border bg-bg-elevated px-4 py-2 text-sm font-medium text-text-muted">
                      Coming soon to the App Store
                    </span>
                  )}
                  <a
                    href={app.privacyPath}
                    class="text-sm font-medium text-accent transition-colors hover:text-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
                  >
                    Privacy
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
