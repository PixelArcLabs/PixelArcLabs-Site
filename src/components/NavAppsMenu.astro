---
import { apps } from '../config/site';

interface Props {
  variant?: 'mobile' | 'desktop';
}

const { variant = 'desktop' } = Astro.props;
const panelId = `apps-menu-panel-${variant}`;

const triggerClass =
  variant === 'desktop'
    ? 'nav-apps-trigger inline-flex items-center gap-1 rounded-full px-4 py-1.5 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-text-muted transition-colors hover:bg-white/5 hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent'
    : 'nav-apps-trigger inline-flex items-center gap-0.5 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-text-muted transition-colors hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-full px-1';
---

<div class="nav-apps-menu relative" data-nav-apps-menu>
  <button
    type="button"
    class={triggerClass}
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls={panelId}
  >
    Apps
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="nav-apps-chevron shrink-0 transition-transform duration-200"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div
    id={panelId}
    class:list={[
      'nav-apps-panel absolute z-50 min-w-[15.5rem]',
      variant === 'desktop'
        ? 'left-0 top-[calc(100%+0.5rem)]'
        : 'right-0 top-[calc(100%+0.5rem)]',
    ]}
    role="menu"
    aria-label="Apps"
    hidden
  >
    <div class="glass-pill nav-apps-panel-surface overflow-hidden rounded-2xl p-1.5 shadow-xl">
      <ul class="space-y-0.5">
        {
          apps.map((app) => (
            <li role="none">
              <a
                href={app.href}
                role="menuitem"
                class="nav-apps-item flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                <img
                  src={app.iconSrc}
                  alt=""
                  width="36"
                  height="36"
                  class="h-9 w-9 shrink-0 rounded-[0.65rem] object-cover ring-1 ring-white/10"
                />
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-text">{app.name}</span>
                  <span class="block truncate text-xs text-text-muted">{app.subtitle}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-1 border-t border-border/60 pt-1">
        <a
          href="/#apps"
          role="menuitem"
          class="nav-apps-item block rounded-xl px-3 py-2 text-center text-xs font-medium text-accent transition-colors hover:bg-white/5 hover:text-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          View all apps
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const menus = document.querySelectorAll('[data-nav-apps-menu]');

  menus.forEach((menu) => {
    const trigger = menu.querySelector('.nav-apps-trigger');
    const panel = menu.querySelector('.nav-apps-panel');
    const chevron = menu.querySelector('.nav-apps-chevron');
    if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const close = () => {
      trigger.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
      panel.classList.remove('is-open');
      chevron?.classList.remove('rotate-180');
    };

    const open = () => {
      document.querySelectorAll('[data-nav-apps-menu] .nav-apps-panel.is-open').forEach((other) => {
        if (other === panel) return;
        other.classList.remove('is-open');
        (other as HTMLElement).hidden = true;
        const otherMenu = other.closest('[data-nav-apps-menu]');
        const otherTrigger = otherMenu?.querySelector('.nav-apps-trigger');
        const otherChevron = otherMenu?.querySelector('.nav-apps-chevron');
        otherTrigger?.setAttribute('aria-expanded', 'false');
        otherChevron?.classList.remove('rotate-180');
      });

      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      requestAnimationFrame(() => panel.classList.add('is-open'));
      chevron?.classList.add('rotate-180');
    };

    const toggle = () => {
      if (panel.classList.contains('is-open')) close();
      else open();
    };

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      toggle();
    });

    panel.querySelectorAll('.nav-apps-item').forEach((link) => {
      link.addEventListener('click', close);
    });

    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  });
</script>
