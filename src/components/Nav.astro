---
import BrandMark from './BrandMark.astro';
import NavAppsMenu from './NavAppsMenu.astro';

const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#support', label: 'Support' },
];

const linkClass =
  'font-mono text-[0.625rem] uppercase tracking-[0.16em] text-text-muted transition-colors hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-full px-1';
---

<header
  id="floating-nav"
  class="floating-nav pointer-events-none fixed inset-x-0 top-0 z-50 pt-4 sm:pt-5"
>
  <!-- Mobile: single glass bar -->
  <nav
    class="glass-pill pointer-events-auto mx-4 flex items-center justify-between gap-2 rounded-full px-3 py-2 sm:mx-6 md:hidden"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="flex shrink-0 items-center justify-center rounded-full p-1.5 transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      aria-label="Pixel Arc Labs home"
    >
      <BrandMark class="h-[5.25rem] w-[5.25rem]" />
    </a>

    <ul class="flex min-w-0 flex-1 items-center justify-center gap-3">
      <li>
        <NavAppsMenu variant="mobile" />
      </li>
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class={linkClass}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/terms" class={linkClass}>Terms</a>
      </li>
      <li>
        <a href="/privacy" class={linkClass}>Privacy</a>
      </li>
    </ul>

    <a
      href="/contact"
      class="shrink-0 rounded-full border border-border px-3 py-1.5 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-text transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      Contact
    </a>
  </nav>

  <!-- Desktop: three floating islands -->
  <div
    class="pointer-events-none mx-auto hidden max-w-4xl items-center justify-between gap-4 px-6 md:flex"
  >
    <nav
      class="glass-pill pointer-events-auto flex items-center gap-1 rounded-full px-2 py-2"
      aria-label="Site sections"
    >
      <NavAppsMenu variant="desktop" />
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-4 py-1.5 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-text-muted transition-colors hover:bg-white/5 hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/"
      class="pointer-events-auto flex items-center justify-center transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
      aria-label="Pixel Arc Labs home"
    >
      <BrandMark class="h-[7.5rem] w-[7.5rem]" />
    </a>

    <nav
      class="glass-pill pointer-events-auto flex items-center gap-1 rounded-full px-2 py-2"
      aria-label="Site actions"
    >
      <a
        href="/terms"
        class="rounded-full px-4 py-1.5 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-text-muted transition-colors hover:bg-white/5 hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        Terms
      </a>
      <a
        href="/privacy"
        class="rounded-full px-4 py-1.5 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-text-muted transition-colors hover:bg-white/5 hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        Privacy
      </a>
      <a
        href="/contact"
        class="rounded-full border border-border px-4 py-1.5 font-mono text-[0.625rem] uppercase tracking-[0.16em] text-text transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<script>
  const nav = document.getElementById('floating-nav');
  if (nav && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let lastScrollY = window.scrollY;
    let ticking = false;

    const updateNav = () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY > lastScrollY && currentScrollY > 72) {
        nav.classList.add('is-hidden');
      } else {
        nav.classList.remove('is-hidden');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateNav);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
