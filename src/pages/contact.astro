---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contact — Pixel Arc Labs"
  description="Get in touch with Pixel Arc Labs for app support and general inquiries."
  path="/contact"
>
  <section class="mx-auto max-w-3xl px-6 pb-16 pt-36 sm:pb-24 sm:pt-44">
    <header>
      <p class="font-mono text-[0.6875rem] uppercase tracking-[0.24em] text-text-muted">
        Contact<span class="mx-3 text-accent">●</span>Pixel Arc Labs
      </p>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-text sm:text-5xl">
        Get in touch<span class="font-display font-normal italic text-accent">.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-text-muted">
        Have a question about a Pixel Arc Labs app? Send me a message — I'll reply shortly.
      </p>
    </header>

    <div class="mt-12">
      <ContactForm />
    </div>
  </section>
</BaseLayout>
