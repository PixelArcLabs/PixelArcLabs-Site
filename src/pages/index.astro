---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Support from '../components/Support.astro';
import { companyName } from '../config/site';
---

<BaseLayout
  title={`${companyName} — Thoughtful apps, built with care`}
  description={`${companyName} is a one-person indie iOS studio building clear, private, and polished applications for iPhone and iPad.`}
  path="/"
>
  <Hero />
  <About />
  <Support />
</BaseLayout>
